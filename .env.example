# Law.go primary adapter
LAWGO_OC=
# Legacy alias used in earlier setup notes. Prefer LAWGO_OC for new deployments.
LAW_OC=
LAWGO_TARGET_ENV=production
# Use "force" only for offline local development. Leave empty in hosted environments.
LAWGO_MOCK_MODE=

# Korean Law MCP augmentation layer
# true면 Law.go 검색 결과를 korean-law-mcp 근거로 보강합니다.
KOREAN_LAW_MCP_ENABLED=false
# 미입력 시 LAWGO_OC를 재사용
KOREAN_LAW_MCP_LAW_OC=

# LLM answer generation
# Gemini is preferred when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash-lite
# Per-call timeout for AI structured deliverables (위험성평가/작업계획/TBM 등).
# gemini-2.5-flash needs 30-45s per JSON doc — do NOT set this below 45000 in prod.
# Deliverables do not inherit GEMINI_TIMEOUT_MS (that one is for the /api/ask answer path).
GEMINI_DELIVERABLES_TIMEOUT_MS=45000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 자유답변(OpenAI) 타임아웃(ms). 미설정 시 20000.
OPENAI_TIMEOUT_MS=

# --- SafeClaw agent runtime (operator-only local POC) ---
# Leave disabled in hosted environments. Vercel always fails closed for local runtimes.
# Supported values: disabled, local-openclaw, experimental-hermes, remote-hermes
SAFECLAW_ENGINE_MODE=disabled
# Hermes is a planner behind the SafeClaw EngineAdapter. It never owns product facts,
# publishes knowledge, or writes directly to Supabase. Local representative POC only.
SAFECLAW_HERMES_LOCAL_POC=0
# Local OpenClaw process execution is opt-in and must stay off on Vercel.
OPENCLAW_LOCAL=0
OPENCLAW_BIN=openclaw
OPENCLAW_PROFILE=safeclaw
OPENCLAW_AGENT=main
OPENCLAW_CHAT_MODEL=openai/gpt-5.5
# Legacy alias remains supported, but OPENCLAW_CHAT_MODEL takes precedence.
# OPENCLAW_MODEL=
OPENCLAW_CHAT_TIMEOUT_MS=240000
OPENCLAW_MAX_CONCURRENT=1
# Required only for experimental-hermes. Use IDs owned by the authenticated operator;
# never put access tokens, OAuth material, or customer secrets in these fields.
SAFECLAW_HERMES_BOUND_ORGANIZATION_ID=
SAFECLAW_HERMES_BOUND_SITE_ID=

# Remote Hermes evaluation naturalizer. This does not authorize production promotion.
# Environment values validate only the contract. Runtime stays unavailable until an
# application-owned connection-pinned transport and durable attempt ledger are injected.
# The worker receives closed claim/citation IDs and enums only.
SAFECLAW_REMOTE_HERMES_ENDPOINT=
# Comma-separated exact hostnames. Wildcards, localhost, and IP literals are rejected.
SAFECLAW_REMOTE_HERMES_HOST_ALLOWLIST=
# Comma-separated organizationId:siteId pairs explicitly approved for evaluation traffic.
SAFECLAW_REMOTE_HERMES_TENANT_ALLOWLIST=
SAFECLAW_REMOTE_HERMES_ISSUER=
SAFECLAW_REMOTE_HERMES_AUDIENCE=
SAFECLAW_REMOTE_HERMES_REQUEST_KEY_ID=
SAFECLAW_REMOTE_HERMES_REQUEST_SIGNING_SECRET=
SAFECLAW_REMOTE_HERMES_SERVICE_ID=
SAFECLAW_REMOTE_HERMES_RESPONSE_KEY_ID=
SAFECLAW_REMOTE_HERMES_RESPONSE_VERIFICATION_SECRET=
# Signed remote-policy-attestation/v1 JSON. It must bind the expected service and endpoint
# and attest allow=[], deny=["*"], required preflight, durable ledger, and durable replay.
# Missing, expired, malformed, or invalidly signed attestations keep traffic disabled.
SAFECLAW_REMOTE_HERMES_POLICY_ATTESTATION=

# 다국어는 별도 번역 API 없이 정적 phrase pack + Gemini로 처리합니다.

DATA_GO_KR_SERVICE_KEY=
KOSHA_SERVICE_KEY=
KOSHA_ACCIDENT_PROXY_URL=
KOSHA_ACCIDENT_PROXY_TOKEN=
# Comma-separated credential-free HTTPS origins approved for configurable
# KOSHA/KIER upstreams. The endpoint URL alone never grants network access.
SAFECLAW_UPSTREAM_ALLOWED_ORIGINS=
WORK24_AUTH_KEY=
# Optional override. Default is:
# https://apis.data.go.kr/B551184/UlvryService/getUlvryPredcInfo
# SafeClaw adds Korea Institute of Energy Research real-time erythemal UV
# signals to the outdoor summer weather evidence bundle.
KIER_ERYTHEMAL_UV_ENDPOINT=
NEXT_PUBLIC_APP_NAME=SafeClaw

# Optional distributed admission control for public legal/KOSHA search routes.
# Configure both values together. A partial/invalid configuration fails closed before provider work.
# When both are absent, the routes honestly report the existing per-instance fallback in
# X-SafeClaw-Rate-Limit. Use a server-only Upstash REST token; never expose it with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional product workspace persistence
# Apply supabase/migrations/002_workspace_productization.sql before enabling writes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for sealing the exact server-generated workpack and DB harness evidence.
# Keep this stable per environment: rotating it invalidates verification of stored workpacks.
SAFECLAW_GENERATION_EVIDENCE_SECRET=
# Optional production smoke only. Use a short-lived Supabase user access token
# when scripts/submission_readiness_smoke.mjs must call protected storage APIs.
# The app UI uses the browser Supabase session, not this variable.
SAFEGUARD_AUTH_TOKEN=

# Optional workflow automation through your Oracle n8n instance
# Local or Oracle-internal runtime only. Do not set this in Vercel.
N8N_INTERNAL_BASE=http://127.0.0.1:5678
# Hosted runtimes such as Vercel must use a public HTTPS relay.
N8N_PUBLIC_BASE=
N8N_WEBHOOK_PATH=safeguard-workpack
N8N_WEBHOOK_TOKEN=
# Backward-compatible direct URL mode
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Real provider dispatch is disabled unless this is set to 1.
# Default route behavior returns a safe fixture response for email/SMS.
SAFEGUARD_RUN_LIVE_DISPATCH=0

# Optional Kakao AlimTalk channel through the n8n/Solapi provider.
# Set to 1 only after the Kakao channel is connected and the AlimTalk template is approved.
SAFEGUARD_KAKAO_ENABLED=0
# Keep these secrets on the Oracle n8n server whenever possible. They are listed
# here only to document the provider contract used by the n8n workflow.
SOLAPI_KAKAO_SENDER_KEY=
SOLAPI_KAKAO_TEMPLATE_ID=
SOLAPI_KAKAO_TEMPLATE_CODE=
SOLAPI_KAKAO_DISABLE_SMS=false

# --- Claude (Anthropic) 시연/파일럿용 선택 프로바이더 ---
# AI_DELIVERABLES_PROVIDER=claude 이고 ANTHROPIC_API_KEY 가 있으면
# 구조화 문서 생성을 Claude 로 라우팅 (실패 시 Vertex 체인으로 자동 fallback)
AI_DELIVERABLES_PROVIDER=
ANTHROPIC_API_KEY=
# 미설정 시 claude-sonnet-5. 시연 최고품질은 claude-opus-4-8
ANTHROPIC_MODEL=

# --- 아침 자동 브리핑 (SafeClaw 2 기둥 4) ---
# Vercel cron이 매일 06:00 KST에 GET /api/briefing/run 호출 시 Authorization:
# Bearer ${CRON_SECRET}을 자동 첨부한다(Vercel 표준). 미설정 시 라우트는 501.
CRON_SECRET=
# 브리핑 대상 사업장 JSON 배열. 각 항목: name(사업장명), question(runAsk에 넣을
# 오늘 작업 한 줄 설명), email(요약 발송 대상 + 문서팩 저장 소유자 계정 이메일).
# 예: [{"name":"안산 제조공장","question":"안산 제조공장 용접 및 지게차 상하차 작업, 외국인 근로자 3명 포함 작업자 6명","email":"you@example.com"}]
BRIEFING_SITES=
