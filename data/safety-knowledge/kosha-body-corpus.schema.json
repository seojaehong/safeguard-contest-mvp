{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeclaw.local/schema/kosha-body-corpus-v1.json",
  "title": "SafeClaw KOSHA local body corpus records",
  "oneOf": [
    { "$ref": "#/$defs/item" },
    { "$ref": "#/$defs/chunk" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "page": {
      "type": "object",
      "required": ["page_number", "char_count", "normalized_char_count", "normalized_text_sha256", "has_image", "ocr_candidate", "body_char_start", "body_char_end", "extraction_status"],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "char_count": { "type": "integer", "minimum": 0 },
        "normalized_char_count": { "type": "integer", "minimum": 0 },
        "normalized_text_sha256": { "$ref": "#/$defs/sha256" },
        "has_image": { "type": "boolean" },
        "ocr_candidate": { "type": "boolean" },
        "body_char_start": { "type": "integer", "minimum": 0 },
        "body_char_end": { "type": "integer", "minimum": 0 },
        "extraction_status": { "enum": ["success", "empty"] }
      }
    },
    "item": {
      "type": "object",
      "required": ["schema_version", "item_id", "source_key", "source_member", "raw_sha256", "extraction_status", "page_count", "pages", "ocr_candidate", "raw_duplicate_of", "text_duplicate_of"],
      "properties": {
        "schema_version": { "const": "safeclaw-kosha-body-corpus/v1" },
        "item_id": { "type": "string" },
        "stable_key": { "type": ["string", "null"] },
        "version_key": { "type": ["string", "null"] },
        "version_lineage": { "type": "object" },
        "source_zip": { "type": ["string", "null"] },
        "source_member": { "type": "string" },
        "source_key": { "type": "string" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "normalized_text_sha256": { "$ref": "#/$defs/sha256" },
        "extraction_status": { "enum": ["success", "boundary", "failure"] },
        "page_count": { "type": "integer", "minimum": 0 },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
        "body": { "type": "string" },
        "ocr_candidate": { "type": "boolean" },
        "ocr_candidate_reasons": { "type": "array", "items": { "type": "string" } },
        "raw_duplicate_of": { "type": ["string", "null"] },
        "text_duplicate_of": { "type": ["string", "null"] },
        "provenance": { "type": "object" }
      }
    },
    "span": {
      "type": "object",
      "required": ["page_number", "char_start", "char_end"],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 1 }
      }
    },
    "chunk": {
      "type": "object",
      "required": ["schema_version", "chunk_id", "chunk_sha256", "item_id", "source_member", "page_start", "page_end", "text", "source_spans"],
      "properties": {
        "schema_version": { "const": "safeclaw-kosha-body-corpus/v1" },
        "chunk_id": { "type": "string" },
        "chunk_sha256": { "$ref": "#/$defs/sha256" },
        "item_id": { "type": "string" },
        "source_member": { "type": "string" },
        "page_start": { "type": "integer", "minimum": 1 },
        "page_end": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "source_spans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/span" } }
      }
    },
    "failure": {
      "type": "object",
      "required": ["schema_version", "item_id", "source_key", "source_member", "error_code", "error_type", "message"],
      "properties": {
        "schema_version": { "const": "safeclaw-kosha-body-corpus/v1" },
        "item_id": { "type": "string" },
        "source_key": { "type": "string" },
        "source_member": { "type": "string" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "error_code": { "type": "string" },
        "error_type": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
