    "tests": "npm.cmd test -- tests/ontology-visualization.test.ts tests/ontology-graph-store.test.ts tests/ontology-query.test.ts tests/ontology-knowledge-tool.test.ts",
    "typecheck": "npm.cmd run typecheck",
    "build": "npm.cmd run build",
    "browserScreenshot": "evaluation/backend-harness-gate-2026-07-08/screenshots/ontology-desktop.png",
