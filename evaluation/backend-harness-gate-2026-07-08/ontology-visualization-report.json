{
  "date": "2026-07-09",
  "status": "published_graph_list_and_obsidian_map_ready",
  "langGraphRequiredNow": false,
  "habermasMachineRequiredNow": false,
  "reasoning": "The immediate product need is a readable, provenance-gated ontology surface. Agent orchestration can come later after DB harness and approved graph promotion are stable.",
  "surfaces": {
    "listView": true,
    "hoverCards": true,
    "obsidianMapView": true,
    "graphJson": "/api/ontology/graph"
  },
  "implementation": {
    "page": "app/ontology/page.tsx",
    "model": "lib/ontology/visualization.ts",
    "styles": "app/globals.css",
    "dataSource": "loadGraph('published')",
    "mapNodeLimit": 32,
    "mapEdgeLimit": 72,
