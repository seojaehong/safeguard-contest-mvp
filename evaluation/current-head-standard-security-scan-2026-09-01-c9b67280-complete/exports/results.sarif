                },
                "region": {
                  "endLine": 21,
                  "startLine": 19
                }
              }
            }
          ],
          "message": {
            "text": "MCP active-token quota can be exceeded through concurrent issuance\n\nToken issuance counts active credentials and inserts in separate operations, so concurrent owner requests can exceed the per-site cap.\n\nSeverity: low\n\nCategory: Race condition\n\nWeaknesses: CWE-362\n\nRemediation:\nMove count-and-insert into a transactionally locked database function or allocate bounded unique token slots."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:2b063c1db5904ddd580f24649dd14d26e300660fead8d17685535a5afcd50590"
          },
