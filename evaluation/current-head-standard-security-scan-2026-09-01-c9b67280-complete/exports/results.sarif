          "message": {
            "text": "Concurrent worker imports bypass the site-transfer gate\n\nWorker import checks existing site assignments before an independent upsert keyed only by organization_id and external_key, permitting concurrent cross-site imports to race into silent reassignment.\n\nSeverity: medium\n\nCategory: Race condition\n\nWeaknesses: CWE-362\n\nRemediation:\nUse a transactional RPC or conditional update that succeeds only when site_id is unchanged and require a separate explicit transfer operation."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:e3de2b08c9799be79931911894eec5714d91e6830bf3334617be9f6d8b4204f8"
          },
