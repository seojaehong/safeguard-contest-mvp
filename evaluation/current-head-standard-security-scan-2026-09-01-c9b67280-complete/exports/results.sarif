          ],
          "message": {
            "text": "HWPX anonymization succeeds without a valid cleanup policy\n\nMissing, malformed, or empty cleanup-token configuration becomes an empty replacement list while outputs are still written with status ok, allowing identifiers to remain in committed templates.\n\nSeverity: medium\n\nCategory: Data exposure\n\nWeaknesses: CWE-200\n\nRemediation:\nFail closed unless a validated non-empty digest-bound policy is present, then verify configured forbidden identifiers are absent before writing success."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:d779f540208bdb15c25764497f6c5d2f5434b88d079026a2327abc97936f0786"
