            }
          ],
          "message": {
            "text": "Upstream DNS validation is vulnerable to resolution-time rebinding\n\nDNS is validated before a later ordinary fetch performs a second resolution.\n\nSeverity: low\n\nCategory: Server side request forgery\n\nWeaknesses: CWE-367\n\nRemediation:\nPin the validated address through a safe dispatcher.\n\nRemediation tests:\n- Negative case fails closed and valid path remains functional.\n\nPreventive controls:\n- Enforce the invariant at the database, transaction, or trusted edge boundary."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:18a925f0ca218889f958da6929f48a98fbfe07546b4bfa59adb389f08d613ff9"
