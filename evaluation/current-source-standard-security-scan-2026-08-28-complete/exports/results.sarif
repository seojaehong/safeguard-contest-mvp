                  "startLine": 76
                }
              }
            }
          ],
          "message": {
            "text": "Direct dispatch-log writes can forge provider delivery receipts\n\nOwner writes can populate provider receipt fields without a server receipt invariant.\n\nSeverity: low\n\nCategory: Improper authorization\n\nWeaknesses: CWE-863\n\nRemediation:\nMake provider receipt fields server-only and idempotent.\n\nRemediation tests:\n- Negative case fails closed and valid path remains functional.\n\nPreventive controls:\n- Enforce the invariant at the database, transaction, or trusted edge boundary."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:04920fe95165a640a5dcf24df626c0ad12838f2ad219fc877627c6bde2c1a9bd"
          },
          "properties": {
            "category": "Improper authorization",
            "confidence": "high",
            "findingId": "csf_722231256d7ab9b3ddd2f2f9",
            "occurrenceId": "occ_0458c46ff009f7d676d04369",
            "severity": "low"
          },
          "ruleId": "integrity.provider-receipt-forgery",
          "ruleIndex": 10
        },
        {
          "level": "note",
          "locations": [
            {
              "message": {
                "text": "sink"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lib/supabase-admin.ts"
                },
                "region": {
                  "endLine": 716,
                  "startLine": 645
                }
              }
            }
          ],
          "message": {
            "text": "Workspace provisioning can create duplicate organizations or sites\n\nProvisioning uses select-then-insert without uniqueness-backed serialization.\n\nSeverity: low\n\nCategory: Race condition\n\nWeaknesses: CWE-362\n\nRemediation:\nAdd uniqueness constraints and transactional upserts.\n\nRemediation tests:\n- Negative case fails closed and valid path remains functional.\n\nPreventive controls:\n- Enforce the invariant at the database, transaction, or trusted edge boundary."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:b9b170434f446ea58a24946c321e9543437c4d147e8d780d77b24ace8d43d927"
          },
          "properties": {
            "category": "Race condition",
            "confidence": "high",
            "findingId": "csf_3cd5aa3228c791e923d6392e",
            "occurrenceId": "occ_04b07b41778b06a3a94c39ce",
            "severity": "low"
          },
          "ruleId": "atomicity.workspace-provisioning",
          "ruleIndex": 3
        },
        {
          "level": "note",
          "locations": [
            {
              "message": {
                "text": "sink"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lib/knowledge-review.ts"
                },
                "region": {
                  "endLine": 1343,
                  "startLine": 1285
                }
              }
            },
            {
              "message": {
                "text": "sink"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lib/knowledge-review.ts"
                },
                "region": {
                  "endLine": 1415,
                  "startLine": 1392
                }
              }
            }
          ],
          "message": {
            "text": "Knowledge review commits event and run transitions non-atomically\n\nThe flow updates events sequentially and later updates the run, allowing partial state.\n\nSeverity: low\n\nCategory: Transaction handling\n\nWeaknesses: CWE-703\n\nRemediation:\nMove the transition into one idempotent database transaction.\n\nRemediation tests:\n- Negative case fails closed and valid path remains functional.\n\nPreventive controls:\n- Enforce the invariant at the database, transaction, or trusted edge boundary."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:45577f59f90e0ef5ee40d29fe8a4969dedfb3e9fde08787dd94aac203fd56351"
          },
          "properties": {
            "category": "Transaction handling",
            "confidence": "high",
            "findingId": "csf_250bd0d0bd02aaf6fb418159",
            "occurrenceId": "occ_188267890904e450b9c91ae8",
            "severity": "low"
          },
          "ruleId": "atomicity.knowledge-review-transition",
          "ruleIndex": 0
        },
        {
          "level": "warning",
          "locations": [
            {
              "message": {
                "text": "root_control"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "supabase/migrations/001_init.sql"
                },
                "region": {
                  "endLine": 17,
                  "startLine": 8
                }
              }
            }
          ],
          "message": {
            "text": "Documents table is exposed without row-level security\n\nThe canonical documents table contains full document fields but no migration enables RLS or defines policies.\n\nSeverity: medium\n\nCategory: Authorization bypass\n\nWeaknesses: CWE-862\n\nRemediation:\nEnable RLS and least-privilege grants.\n\nRemediation tests:\n- Negative case fails closed and valid path remains functional.\n\nPreventive controls:\n- Enforce the invariant at the database, transaction, or trusted edge boundary."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:c2ef4478833d274af3379d3d386b2d5e189c6c9fef898c1c149abeae8158e829"
          },
          "properties": {
