                  "uri": "supabase/migrations/001_init.sql"
                },
                "region": {
                  "endLine": 6,
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "Query logs table is exposed without row-level security\n\nquery_logs stores user query text without RLS or access policies.\n\nSeverity: low\n\nCategory: Authorization bypass\n\nWeaknesses: CWE-862\n\nRemediation:\nEnable RLS and restrict reads and inserts.\n\nRemediation tests:\n- Negative case fails closed and valid path remains functional.\n\nPreventive controls:\n- Enforce the invariant at the database, transaction, or trusted edge boundary."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:18a5735d923d7701130181aeb5c431a30f2c3490a26afa55ebe5c7dc347e186e"
