+
+
+   function downloadDoc() {
+     downloadBlob(
+       new Blob([buildWordHtml(selected.title, selectedRows, data.scenario, selectedFormProfile, authorityData, riskAssessmentRows)], { type: "application/msword;charset=utf-8" }),
+       `${baseName}.doc`
+     );
