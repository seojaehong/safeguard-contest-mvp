+         })
+       });
+       if (!response.ok) {
+         throw new Error(`hwp export failed (${response.status})`);
+       }
+       const blob = await response.blob();
+       downloadBlob(blob, `${baseName}.hwp`);
+       setHwpStatus("idle");
