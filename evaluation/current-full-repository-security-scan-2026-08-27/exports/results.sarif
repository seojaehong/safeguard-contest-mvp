            "confidence": "high",
            "findingId": "csf_f75d6f1cd78d8c433440f49c",
            "occurrenceId": "occ_39c3459f354d826160a1f820",
            "severity": "low"
          },
          "ruleId": "race-condition.workspace-provisioning",
          "ruleIndex": 12
        },
        {
          "level": "note",
          "locations": [
