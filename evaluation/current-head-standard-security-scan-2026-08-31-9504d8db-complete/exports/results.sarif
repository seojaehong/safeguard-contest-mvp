                "region": {
                  "endLine": 278,
                  "startLine": 247
                }
              }
            }
          ],
          "message": {
            "text": "MCP active-token quota remains non-atomic\n\nToken issuance counts active MCP tokens and inserts the new token in separate operations, so concurrent requests can exceed the configured active-token cap.\n\nSeverity: low\n\nCategory: Race condition quota enforcement\n\nWeaknesses: CWE-362\n\nRemediation:\nEnforce the quota atomically with a database transaction, advisory lock, or per-owner unique slot model, then test simultaneous issuance."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:d081c065cd15bf07d986a9ee6fd8052ea9b7ce215d823be57c607c6952b6f622"
          },
          "properties": {
            "category": "race-condition.quota-enforcement",
            "confidence": "medium",
            "findingId": "csf_09001652155a49d6a98b106c",
            "occurrenceId": "occ_07867f4f7dbd7f70a0f4c4bc",
            "severity": "low"
          },
          "ruleId": "race-condition.quota-enforcement",
          "ruleIndex": 10
        },
        {
          "level": "warning",
          "locations": [
            {
              "message": {
                "text": "sink"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lib/knowledge-review.ts"
                },
                "region": {
                  "endLine": 1415,
                  "startLine": 1285
                }
              }
            }
          ],
          "message": {
            "text": "Knowledge review transitions are not atomic\n\nReview event rows are updated iteratively before the run state is committed, so errors or concurrent reviewers can leave a partially transitioned run.\n\nSeverity: medium\n\nCategory: Race condition review transition\n\nWeaknesses: CWE-362, CWE-667\n\nRemediation:\nApproval-gated: implement one transactional review-transition RPC with expected-state checks, atomic event updates, and idempotent retry semantics."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:c67341c23ee613b984ebc09581deaee5fd5e049a5ec0d35ec6a01bf877460c49"
          },
          "properties": {
