          ],
          "message": {
            "text": "Approval gates are not bound to current source and artifact digests\n\nKOSHA review, RLS/Wiki, distributed admission, and recipient ACK preflights consume historical reports without consistently binding sourceHead, productCommit, and input artifact digests to the active HEAD and packet.\n\nSeverity: low\n\nCategory: Approval integrity stale evidence binding\n\nWeaknesses: CWE-345\n\nRemediation:\nRecord and verify current HEAD, production commit, and SHA-256 digests for every required input; fail closed on stale or mixed-source evidence and preserve separate mutation approval."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:3ab476be968538dcefb3f71c50e0fa3eb2971df0d9759d8517485581ee72e3cc"
          },
