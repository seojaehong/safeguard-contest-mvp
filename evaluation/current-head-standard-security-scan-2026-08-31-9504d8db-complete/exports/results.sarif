            "confidence": "medium",
            "findingId": "csf_c99d8b37c571732d798966c6",
            "occurrenceId": "occ_1ca4c2f32ca87995dff0472b",
            "severity": "medium"
          },
          "ruleId": "race-condition.review-transition",
          "ruleIndex": 11
        },
