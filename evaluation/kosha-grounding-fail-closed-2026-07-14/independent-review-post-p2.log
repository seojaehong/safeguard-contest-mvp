      lifecycle: string;
      reviewState: string;
      provenance: string;
    } | null;
  };
};

type GroundingSearchProjection = {
  koshaGrounding?: {
    status: string;
    reason: string;
    localGateReason?: string | null;
    localCorpusStatus: string;
    acceptedCount: number;
    reviewRequiredCount: number;
