+      status: "review_required",
+      reason: reviewRequired[0]?.reason || "metadata-absent",
+      localGateReason,
+      localCorpusStatus,
+      acceptedCount,
+      reviewRequiredCount: reviewRequired.length,
+      excludedCount
+    };
+  }
+  if (acceptedCount) {
+    return {
+      status: "ready",
+      reason: "verified-current",
+      localGateReason,
+      localCorpusStatus,
+      acceptedCount,
+      reviewRequiredCount: 0,
+      excludedCount
+    };
+  }
+  if (input.blockedReason) {
+    return {
+      status: "blocked",
+      reason: input.blockedReason,
+      localGateReason,
+      localCorpusStatus,
+      acceptedCount: 0,
+      reviewRequiredCount: 0,
+      excludedCount
+    };
+  }
+  return {
+    status: "not_applicable",
+    reason: "not-applicable",
+    localGateReason,
+    localCorpusStatus,
+    acceptedCount: 0,
+    reviewRequiredCount: 0,
+    excludedCount
+  };
