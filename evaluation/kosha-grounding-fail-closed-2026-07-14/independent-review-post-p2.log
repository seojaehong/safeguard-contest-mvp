    mobileDock.summary = "기계설비명: 이동식도크. 컨테이너와 결합하여 지게차로 상하차 작업을 하는 장비";
    mobileDock.keywords = ["창고업", "이동식도크", "Mobile dock"];
    mobileDock.risk_tags = ["지게차"];
    mobileDock.controls = [
      "가동부 방호덮개 설치 및 비상정지장치 작동 확인",
